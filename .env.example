# Copia questo file in `.env.local` per lo sviluppo locale (`.env.local` è ignorato da git).
# Le variabili VITE_* sono esposte al browser: inserire SOLO valori pubblici, mai secret.

# --- Supabase (locale: valori stampati da `pnpm exec supabase status`, disponibili da M2) ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=local-dev-placeholder

# --- App ---
VITE_APP_URL=http://localhost:5173
VITE_APP_ENV=development            # development | staging | production

# --- Servizi opzionali (vuoti in locale) ---
VITE_TURNSTILE_SITE_KEY=
VITE_SENTRY_DSN=
